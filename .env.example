# FloodGuard AI — Environment Configuration Example
# Copy this file to .env and populate credentials as needed.
# Note: FloodGuard AI functions completely offline with authentic Trishuli 2026
# benchmark fixtures and deterministic calculation engines if API keys are omitted.

# Application Configuration
APP_NAME="FloodGuard AI"
ENVIRONMENT="development"
DEBUG=true

# Copernicus Data Space Ecosystem (CDSE)
# Register for free credentials at https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=""
CDSE_CLIENT_SECRET=""

# AI Situation-Report Copilot LLM APIs (Optional)
# If omitted, FloodGuard AI uses its built-in deterministic bilingual (English & Nepali) engine.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# OpenStreetMap Overpass & ohsome endpoints
OVERPASS_URL="https://overpass-api.de/api/interpreter"
OHSOME_API_URL="https://api.ohsome.org/v1"
